# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# Firebase Web SDK configuration for the new Firebase project.
# Copy all four values from Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials for token verification.
# VITE_FIREBASE_PROJECT_ID must match the web client's Firebase project.
# Never expose FIREBASE_CLIENT_EMAIL or FIREBASE_PRIVATE_KEY to the browser.
FIREBASE_CLIENT_EMAIL=
# Keep the private key in quotes and encode each line break as \n.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Frontend build variable: set to the Render backend origin in Vercel.
VITE_API_URL=

# Backend CORS: comma-separated frontend origins, including the Vercel production domain.
CORS_ALLOWED_ORIGINS=

# PostgreSQL: use DATABASE_URL or the individual SQL_* connection variables.
DATABASE_URL=
SQL_HOST=
SQL_PORT=5432
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
